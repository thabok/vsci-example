{
    "name": "C++ Seat Heating Controller",
    "build": {
        "dockerfile": "Dockerfile",
        "options": [
            "--platform=linux/amd64"
        ]
    },
    "postCreateCommand": "bash .devcontainer/install-btc-extensions.sh",
    "runArgs": [],
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cpptools-extension-pack",
                "ms-vscode.cmake-tools"
            ],
            "settings": {
                "cmake.ctest.testExplorerIntegrationEnabled": true,
                "cmake.configureOnOpen": true,
                "cmake.useCMakePresets": "always",
                "cmake.configurePreset": "dev-debug",
                "cmake.buildPreset": "dev-debug",
                "cmake.testPreset": "dev-debug",
                "cmake.options.statusBarVisibility": "hidden"
            }
        }
    }
}
